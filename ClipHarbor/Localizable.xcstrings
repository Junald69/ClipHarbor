    "licenses_adaway_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipHarbor adapts the open-source AdAway Default Blocklist into WebKit Content Rule List format to block known tracking and advertising domains directly on device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AdAway Default Blocklist をWebKitコンテンツルール形式に変換して採用し、既知の広告・トラッカー配信ドメインを端末内で直接ブロックします。"
          }
        }
      }
    },
    "licenses_adaway_license": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source: AdAway (commit f39ba0a)\nLicense: Creative Commons Attribution 3.0 Unported (CC BY 3.0)\nAdaptation: Converted hosts format to WebKit url-filter rules."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出典: AdAway (コミット f39ba0a)\nライセンス: Creative Commons Attribution 3.0 Unported (CC BY 3.0)\n改変内容: hosts形式からWebKit url-filterルールへ変換して同梱"
          }
        }
      }
    },
    "licenses_apple_sdks_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipHarbor is built solely using Apple native SwiftUI, AVFoundation, WebKit, CryptoKit, CommonCrypto, Security, and LocalAuthentication frameworks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipHarborはApple標準のSwiftUI, AVFoundation, WebKit, CryptoKit, CommonCrypto, Security, LocalAuthenticationフレームワークのみを使用して構築されています。"
          }
        }
      }
    },
    "licenses_dl04_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct video stream URLs containing authorization tokens are never persisted in saved video metadata. Only the web page URL viewed in the browser is safely stored."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済み動画のメタデータには動画自体の直接URL（認証トークン等を含むURL）は永続化されず、ブラウザで閲覧していたWebページURLのみが安全に保持されます。"
          }
        }
      }
    },
    "licenses_third_party_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No external cloud analytics, tracking, or ad distribution SDKs are integrated. Network communications only occur between the user and the websites or video hosts they visit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部のクラウド解析、トラッキング、広告配信SDKは一切組み込まれていません。通信はユーザー自身がアクセスするWebサイトおよび動画ホストとの間でのみ行われます。"
          }
        }
      }
    },
    "licenses_vault_enc_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files in the Vault are encrypted locally with AES-256-GCM and protected by a master key derived from your passcode. Keys are never transmitted to external servers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫内のファイルはAES-256-GCMによりローカルでストリーム暗号化され、パスコードから導出されたマスター鍵で保護されます。外部サーバーへの鍵送信は行われません。"
          }
        }
      }
    },
    "vault_error_locked_out %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Incorrect passcode entered multiple times. Locked out. Please try again in %lld minute."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Incorrect passcode entered multiple times. Locked out. Please try again in %lld minutes."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "パスコードの誤入力が制限回数を超えたためロックされています。あと%lld分後に再試行してください。"
                }
              }
            }
          }
        }
      }
    },
    "vault_unlock_lockout_warning %lld": {
