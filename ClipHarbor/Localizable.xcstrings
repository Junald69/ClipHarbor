      }
    },
    "licenses_apple_sdks_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipHarbor is built solely using Apple native SwiftUI, AVFoundation, WebKit, CryptoKit, CommonCrypto, Security, and LocalAuthentication frameworks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ClipHarborはApple標準のSwiftUI, AVFoundation, WebKit, CryptoKit, CommonCrypto, Security, LocalAuthenticationフレームワークのみを使用して構築されています。"
          }
        }
      }
    },
    "Third-Party SDKs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Third-Party SDKs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サードパーティ製SDK"
          }
        }
      }
    },
    "licenses_third_party_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No external cloud analytics, tracking, or ad distribution SDKs are integrated. Network communications only occur between the user and the websites or video hosts they visit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部のクラウド解析、トラッキング、広告配信SDKは一切組み込まれていません。通信はユーザー自身がアクセスするWebサイトおよび動画ホストとの間でのみ行われます。"
          }
        }
      }
    },
    "Security & Privacy Policy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Security & Privacy Policy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティ・プライバシー保護方針"
          }
        }
      }
    },
    "Token Leakage Prevention (DL-04)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Token Leakage Prevention (DL-04)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークン漏洩防止 (DL-04)"
          }
        }
      }
    },
    "licenses_dl04_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct video stream URLs containing authorization tokens are never persisted in saved video metadata. Only the web page URL viewed in the browser is safely stored."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済み動画のメタデータには動画自体の直接URL（認証トークン等を含むURL）は永続化されず、ブラウザで閲覧していたWebページURLのみが安全に保持されます。"
          }
        }
      }
    },
    "Private Vault Encryption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Vault Encryption"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Vault の暗号化"
          }
        }
      }
    },
    "licenses_vault_enc_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files in the Vault are encrypted locally with AES-256-GCM and protected by a master key derived from your passcode. Keys are never transmitted to external servers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管庫内のファイルはAES-256-GCMによりローカルでストリーム暗号化され、パスコードから導出されたマスター鍵で保護されます。外部サーバーへの鍵送信は行われません。"
          }
        }
      }
    },
    "Licenses & Policy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Licenses & Policy"
          }
        },
