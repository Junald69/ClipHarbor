    "Frees temporary memory cache. Saved video files and data on disk will not be deleted." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frees temporary memory cache. Saved video files and data on disk will not be deleted."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリ上の一時キャッシュを解放します。保存済みの動画ファイルやディスク上のデータは消去されません。"
          }
        }
      }
    },
